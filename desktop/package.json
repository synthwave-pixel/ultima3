{
  "name": "ultima3-desktop",
  "productName": "Ultima III",
  "version": "1.0.0",
  "description": "Ultima III: Exodus, LairWare's Macintosh port rebuilt for the browser, as a desktop app",
  "author": "synthwave-pixel",
  "license": "MIT",
  "private": true,
  "main": "main.cjs",
  "scripts": {
    "bundle": "node bundle.cjs",
    "start": "electron .",
    "smoke": "node smoke.cjs",
    "smoke:built": "node smoke-built.cjs",
    "dist": "node dist.cjs",
    "dist:linux": "node dist.cjs --linux",
    "dist:win": "node dist.cjs --win",
    "dist:mac": "node dist.cjs --mac",
    "version:show": "node version.cjs"
  },
  "devDependencies": {
    "electron": "^44.7.0",
    "electron-builder": "^26.17.0"
  },
  "build": {
    "appId": "com.synthwavepixel.ultima3",
    "productName": "Ultima III",
    "artifactName": "Ultima-III-${version}-${os}-${arch}.${ext}",
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "files": [
      "main.cjs",
      "preload.cjs",
      "updates.cjs",
      "steamArt.cjs",
      "windowState.cjs",
      "portable.cjs",
      "build/steam/*.png",
      "app/**/*"
    ],
    "asar": true,
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "grantFileProtocolExtraPrivileges": false
    },
    "mac": {
      "category": "public.app-category.role-playing-games",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "arm64"
          ]
        }
      ],
      "identity": "-",
      "hardenedRuntime": false,
      "extendInfo": {
        "NSMicrophoneUsageDescription": "Ultima III never uses the microphone. macOS can ask when the game's sound plays through a device that is also a microphone, such as a USB microphone or a headset. Choose Don't Allow: the game and its sound play on as before.",
        "NSAudioCaptureUsageDescription": "Ultima III never records any sound. Choose Don't Allow: the game and its sound play on as before.",
        "NSCameraUsageDescription": "Ultima III never uses the camera. Choose Don't Allow: the game plays on as before."
      }
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "Ultima-III-${version}-${os}-${arch}-setup.${ext}"
    },
    "portable": {
      "artifactName": "Ultima-III-${version}-${os}-${arch}-portable.${ext}"
    },
    "linux": {
      "category": "Game",
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "desktop": {
        "entry": {
          "Name": "Ultima III",
          "Comment": "Ultima III: Exodus"
        }
      }
    },
    "flatpak": {
      "files": [
        [
          "build-meta/com.synthwavepixel.ultima3.metainfo.xml",
          "/share/metainfo/com.synthwavepixel.ultima3.metainfo.xml"
        ]
      ],
      "runtimeVersion": "25.08",
      "baseVersion": "25.08",
      "finishArgs": [
        "--socket=wayland",
        "--socket=x11",
        "--share=ipc",
        "--device=all",
        "--filesystem=/run/udev:ro",
        "--socket=pulseaudio",
        "--filesystem=home"
      ]
    }
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/synthwave-pixel/ultima3.git"
  }
}
