{
  "name": "ultima3-web",
  "version": "0.1.0",
  "private": true,
  "description": "Browser port (TypeScript + Canvas) of LairWare's Ultima III for the Macintosh.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "node tools/graphics-index.ts && tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "extract": "node tools/extract-resources.ts",
    "figures": "node tools/compose-figures.ts",
    "graphics-index": "node tools/graphics-index.ts",
    "sfx": "node tools/chip-sfx.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^22.0.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "3.8.1",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.0.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^3.0.0"
  }
}
